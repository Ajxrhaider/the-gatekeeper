# Copy this file to .env.local and replace both placeholders.
# GEMINI_API_KEY comes from Google AI Studio; never expose it to the browser.
GEMINI_API_KEY=replace_with_a_google_ai_studio_api_key
# Generate a 32-byte base64url key locally; this encrypts session cookies and is not the challenge phrase.
GATEKEEPER_SESSION_KEY=replace_with_a_32_byte_base64url_key
